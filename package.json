{
  "name": "phos",
  "version": "0.4.0",
  "private": true,
  "description": "PHOS — Personal Hifz Operating System. A local-first, offline-first, single-user application for scientifically informed Quran memorization scheduling.",
  "engines": {
    "node": ">=20.19.0"
  },
  "//": "package-lock.json is generated by the Node version in .nvmrc. Regenerating it on an older major can make CI's npm report packages as missing from the lock — see the note in .github/workflows/ci.yml.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/build-precache.mjs",
    "preview": "serve out -l 3000",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "jest --passWithNoTests",
    "test:ui:watch": "jest --watch",
    "test:all": "npm run test && npm run test:ui",
    "gate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:ui && npm run build && node scripts/verify-precache.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "clsx": "^2.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.400.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "latest",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "@tailwindcss/postcss": "^4.3.3"
  }
}
